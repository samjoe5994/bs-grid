{
  "name": "bs-grid",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "npm run build:lib && ng serve demo",
    "build": "npm run build:lib && ng build demo",
    "build:lib": "ng build bs-grid",
    "build:demo": "ng build demo",
    "watch:lib": "ng build bs-grid --watch --configuration development",
    "test": "ng test bs-grid",
    "pack:lib": "npm run build:lib && cd dist/bs-grid && npm pack",
    "publish:lib": "npm run build:lib && cd dist/bs-grid && npm publish"
  },
  "private": true,
  "packageManager": "npm@11.18.0",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.19",
    "@angular/cli": "^21.2.17",
    "@angular/compiler-cli": "^21.2.0",
    "jsdom": "^28.0.0",
    "ng-packagr": "^21.2.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
